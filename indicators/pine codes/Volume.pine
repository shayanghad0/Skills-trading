//@version=5
indicator(title="Volume", shorttitle="Volume", format=format.volume, overlay=false)

// ————— Inputs —————
colUp     = input.color(color.new(color.green, 30), "Up Volume")
colDown   = input.color(color.new(color.red, 30),   "Down Volume")
showMA    = input.bool(true, "Show Moving Average")
maLength  = input.int(20, "MA Length", minval=1)

// ————— Calculations —————
up   = close > open
down = close < open
vol  = volume

// ————— Plot volume bars —————
plot(vol, style=plot.style_columns,
     color=up ? colUp : down ? colDown : na,
     title="Volume")

// ————— Plot moving average —————
volMA = ta.sma(vol, maLength)

// ————— Zero line (optional, clean look) —————
hline(0, color=color.gray, linestyle=hline.style_dotted, linewidth=1)